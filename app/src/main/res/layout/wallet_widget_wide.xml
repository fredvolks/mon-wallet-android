<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:paddingStart="9dp" android:paddingEnd="9dp"
 android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/widget_background_wide">
 <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#F1F7FA" android:textSize="15sp" android:textStyle="bold"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CAD" android:textSize="9sp" android:textColor="#8FA8B8" android:layout_marginEnd="8dp"/>
  <TextView android:id="@+id/widget_refresh" android:layout_width="30dp" android:layout_height="match_parent" android:gravity="center" android:text="↻" android:textSize="23sp" android:textColor="#DFEDF2" android:contentDescription="@string/widget_refresh"/>
  <TextView android:id="@+id/widget_configure" android:layout_width="25dp" android:layout_height="match_parent" android:gravity="center" android:text="⚙" android:textSize="17sp" android:textColor="#DFEDF2" android:contentDescription="@string/widget_configure"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
  <LinearLayout android:layout_width="0dp" android:layout_weight="41" android:layout_height="match_parent" android:orientation="vertical">
   <LinearLayout android:id="@+id/widget_day_pill" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingStart="2dp" android:paddingEnd="2dp">
    <LinearLayout android:id="@+id/widget_day_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
     <TextView android:id="@+id/widget_day" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#9FB2C0" android:textSize="9sp" android:maxLines="1"/>
     <TextView android:id="@+id/widget_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:includeFontPadding="false" android:singleLine="true" android:textStyle="bold" android:textColor="#58F48B" android:textSize="26sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="17sp" android:autoSizeMaxTextSize="26sp" android:autoSizeStepGranularity="1sp"/>
     <TextView android:id="@+id/widget_percent" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:includeFontPadding="false" android:singleLine="true" android:textStyle="bold" android:textColor="#58F48B" android:textSize="18sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="13sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp"/>
    </LinearLayout>
    <ImageView android:id="@+id/widget_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="3dp" android:scaleType="fitXY" android:visibility="gone" android:contentDescription="@string/widget_chart_description"/>
   </LinearLayout>
   <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#26424E"/>
   <LinearLayout android:id="@+id/widget_total_group" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical" android:paddingStart="2dp" android:paddingEnd="2dp">
    <TextView android:id="@+id/widget_total_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#A9C0CA" android:singleLine="true" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:includeFontPadding="false" android:textStyle="bold" android:textSize="16sp" android:textColor="#58F48B"/>
   </LinearLayout>
   <TextView android:id="@+id/widget_extras" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>
  </LinearLayout>
  <TextView android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_marginEnd="6dp" android:background="#25424E"/>
  <LinearLayout android:id="@+id/widget_rows" android:layout_width="0dp" android:layout_weight="59" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical"/>
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="3dp" android:background="#26424E"/>
            <LinearLayout android:id="@+id/widget_indices"
                android:layout_width="match_parent" android:layout_height="18dp"
                android:layout_marginTop="1dp" android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout android:id="@+id/widget_sp500_group" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/widget_sp500_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="S&amp;P 500" android:textColor="#9FBAC5" android:textSize="8sp"
                        android:includeFontPadding="false" android:singleLine="true"/>
                    <TextView android:id="@+id/widget_sp500" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#C9DDE4"
                        android:textSize="10sp" android:includeFontPadding="false" android:singleLine="true"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/widget_nasdaq_group" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/widget_nasdaq_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="NASDAQ" android:textColor="#9FBAC5" android:textSize="8sp"
                        android:includeFontPadding="false" android:singleLine="true"/>
                    <TextView android:id="@+id/widget_nasdaq" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#C9DDE4"
                        android:textSize="10sp" android:includeFontPadding="false" android:singleLine="true"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/widget_dow_group" android:layout_width="0dp"
                    android:layout_height="match_parent" android:layout_weight="1"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/widget_dow_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DOW JONES" android:textColor="#9FBAC5" android:textSize="8sp"
                        android:includeFontPadding="false" android:singleLine="true"/>
                    <TextView android:id="@+id/widget_dow" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#C9DDE4"
                        android:textSize="10sp" android:includeFontPadding="false" android:singleLine="true"/>
                </LinearLayout>
            </LinearLayout>

 <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="9dp" android:gravity="end|bottom" android:singleLine="true" android:ellipsize="end" android:textColor="#849BA8" android:textSize="7sp"/>
</LinearLayout>
