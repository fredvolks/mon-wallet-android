<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="9dp" android:paddingEnd="9dp"
    android:paddingTop="4dp" android:paddingBottom="4dp"
    android:background="@drawable/widget_background_wide">

    <LinearLayout android:layout_width="match_parent" android:layout_height="23dp"
        android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:singleLine="true" android:ellipsize="end"
            android:textColor="#F1F7FA" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/widget_refresh" android:layout_width="27dp"
            android:layout_height="match_parent" android:gravity="center"
            android:text="↻" android:textSize="22sp" android:textColor="#DFEDF2"
            android:contentDescription="@string/widget_refresh"/>
        <TextView android:id="@+id/widget_configure" android:layout_width="27dp"
            android:layout_height="match_parent" android:gravity="center"
            android:text="⚙" android:textSize="18sp" android:textColor="#DFEDF2"
            android:contentDescription="@string/widget_configure"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_body" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="45"
            android:layout_height="match_parent" android:orientation="vertical"
            android:paddingBottom="1dp">
            <LinearLayout android:id="@+id/widget_day_pill"
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:orientation="vertical"
                android:gravity="center_vertical" android:paddingStart="7dp"
                android:paddingEnd="4dp" android:background="@drawable/widget_pill_positive">
                <TextView android:id="@+id/widget_day" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:includeFontPadding="false"
                    android:textColor="#B9D2C8" android:textSize="10sp" android:maxLines="1"/>
                <TextView android:id="@+id/widget_amount" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:includeFontPadding="false"
                    android:singleLine="true" android:textStyle="bold" android:textColor="#58F48B"
                    android:textSize="35sp" android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="35sp"
                    android:autoSizeStepGranularity="1sp"/>
                <TextView android:id="@+id/widget_percent" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:includeFontPadding="false"
                    android:singleLine="true" android:textStyle="bold" android:textColor="#58F48B"
                    android:textSize="24sp" android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="26sp"
                    android:autoSizeStepGranularity="1sp"/>
                <ImageView android:id="@+id/widget_chart" android:layout_width="match_parent"
                    android:layout_height="13dp" android:scaleType="fitXY"
                    android:visibility="gone" android:contentDescription="@string/widget_chart_description"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_total_group"
                android:layout_width="match_parent" android:layout_height="27dp"
                android:layout_marginTop="3dp" android:gravity="center_vertical"
                android:paddingStart="7dp" android:paddingEnd="6dp"
                android:background="@drawable/widget_total_capsule">
                <TextView android:id="@+id/widget_total_label" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content"
                    android:textSize="9sp" android:textColor="#A9C0CA" android:singleLine="true"
                    android:ellipsize="end"/>
                <TextView android:id="@+id/widget_total" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:singleLine="true"
                    android:includeFontPadding="false" android:textStyle="bold"
                    android:textSize="17sp" android:textColor="#58F48B"/>
            </LinearLayout>
            <TextView android:id="@+id/widget_extras" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:singleLine="true"
                android:ellipsize="end" android:textSize="8sp" android:textColor="#91A8B5"
                android:visibility="gone"/>
        </LinearLayout>
        <TextView android:layout_width="1dp" android:layout_height="match_parent"
            android:layout_marginStart="5dp" android:layout_marginEnd="6dp"
            android:background="#25424E"/>
        <LinearLayout android:id="@+id/widget_rows" android:layout_width="0dp"
            android:layout_weight="55" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center_vertical"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent"
        android:layout_height="10dp" android:gravity="end|bottom"
        android:singleLine="true" android:ellipsize="end"
        android:textColor="#849BA8" android:textSize="8sp"/>
</LinearLayout>
