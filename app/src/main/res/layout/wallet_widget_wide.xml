<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:background="@drawable/widget_background_wide">

    <LinearLayout android:layout_width="match_parent" android:layout_height="25dp"
        android:gravity="center_vertical">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:singleLine="true" android:ellipsize="end"
            android:textColor="#F1F7FA" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/widget_configure" android:layout_width="31dp"
            android:layout_height="match_parent" android:gravity="center"
            android:text="⚙" android:textSize="19sp" android:textColor="#DFEDF2"
            android:contentDescription="@string/widget_configure"/>
        <TextView android:id="@+id/widget_refresh" android:layout_width="31dp"
            android:layout_height="match_parent" android:gravity="center"
            android:text="↻" android:textSize="24sp" android:textColor="#DFEDF2"
            android:contentDescription="@string/widget_refresh"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_body" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="38"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:gravity="center_vertical">
            <LinearLayout android:id="@+id/widget_total_group"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:id="@+id/widget_total" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:singleLine="true"
                    android:includeFontPadding="false" android:textStyle="bold"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="20sp"
                    android:autoSizeMaxTextSize="32sp" android:autoSizeStepGranularity="1sp"
                    android:textColor="#58F48B" android:textSize="32sp"/>
                <TextView android:id="@+id/widget_total_label" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="8sp"
                    android:letterSpacing="0.1" android:textColor="#91A8B5"
                    android:maxLines="1"/>
            </LinearLayout>
            <TextView android:id="@+id/widget_day" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="7dp"
                android:textColor="#91A8B5" android:textSize="9sp" android:maxLines="1"/>
            <LinearLayout android:id="@+id/widget_day_pill"
                android:layout_width="wrap_content" android:layout_height="23dp"
                android:layout_marginTop="3dp" android:gravity="center_vertical"
                android:paddingStart="7dp" android:paddingEnd="7dp"
                android:background="@drawable/widget_pill_positive">
                <TextView android:id="@+id/widget_amount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:singleLine="true"
                    android:textColor="#58F48B" android:textStyle="bold" android:textSize="12sp"/>
                <TextView android:id="@+id/widget_percent" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="6dp"
                    android:singleLine="true" android:textColor="#58F48B"
                    android:textStyle="bold" android:textSize="12sp"/>
            </LinearLayout>
            <TextView android:id="@+id/widget_extras" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:singleLine="true"
                android:ellipsize="end" android:textSize="8sp" android:textColor="#91A8B5"/>
        </LinearLayout>
        <TextView android:layout_width="1dp" android:layout_height="76dp"
            android:layout_marginStart="3dp" android:layout_marginEnd="8dp"
            android:background="#25424E"/>
        <LinearLayout android:id="@+id/widget_rows" android:layout_width="0dp"
            android:layout_weight="62" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_vertical"/>
    </LinearLayout>
    <ImageView android:id="@+id/widget_chart" android:layout_width="match_parent"
        android:layout_height="23dp" android:scaleType="fitXY" android:visibility="gone"
        android:contentDescription="@string/widget_chart_description"/>
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent"
        android:layout_height="11dp" android:gravity="bottom"
        android:singleLine="true" android:ellipsize="end"
        android:textColor="#849BA8" android:textSize="8sp"/>
</LinearLayout>
