<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row" android:layout_width="match_parent"
    android:layout_height="20dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/widget_row_logo" android:layout_width="18dp"
        android:layout_height="18dp" android:layout_marginEnd="3dp"
        android:scaleType="fitCenter" android:contentDescription="@string/widget_logo"/>
    <TextView android:id="@+id/widget_row_fallback" android:layout_width="18dp"
        android:layout_height="18dp" android:layout_marginEnd="3dp"
        android:gravity="center" android:singleLine="true" android:visibility="gone"
        android:background="@drawable/widget_logo_fallback"
        android:textColor="#BDE6EF" android:textStyle="bold" android:textSize="8sp"/>
    <TextView android:id="@+id/widget_row_ticker" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="wrap_content"
        android:singleLine="true" android:ellipsize="end"
        android:textColor="#F0F5F7" android:fontFamily="monospace"
        android:textStyle="bold" android:textSize="10sp"/>
    <TextView android:id="@+id/widget_row_session" android:layout_width="12dp"
        android:layout_height="wrap_content" android:gravity="center" android:singleLine="true"
        android:textSize="10sp" android:visibility="gone"/>
    <TextView android:id="@+id/widget_row_price" android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp" android:gravity="end"
        android:singleLine="true" android:ellipsize="end"
        android:textColor="#DAE6EB" android:textSize="10sp"/>
    <TextView android:id="@+id/widget_row_values" android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp" android:gravity="end"
        android:singleLine="true" android:ellipsize="end"
        android:textColor="#59ED8A" android:textStyle="bold" android:textSize="10sp"/>
</LinearLayout>
