<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row" android:layout_width="match_parent"
    android:layout_height="25dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/widget_row_logo" android:layout_width="22dp"
        android:layout_height="22dp" android:layout_marginEnd="5dp"
        android:scaleType="fitCenter" android:contentDescription="@string/widget_logo"/>
    <TextView android:id="@+id/widget_row_fallback" android:layout_width="22dp"
        android:layout_height="22dp" android:layout_marginEnd="5dp"
        android:gravity="center" android:singleLine="true" android:visibility="gone"
        android:background="@drawable/widget_logo_fallback"
        android:textColor="#BDE6EF" android:textStyle="bold" android:textSize="8sp"/>
    <TextView android:id="@+id/widget_row_ticker" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="wrap_content"
        android:singleLine="true" android:ellipsize="end"
        android:textColor="#F0F5F7" android:textStyle="bold" android:textSize="10sp"/>
    <TextView android:id="@+id/widget_row_price" android:layout_width="0dp"
        android:layout_weight="1.5" android:layout_height="wrap_content"
        android:layout_marginStart="3dp" android:gravity="end"
        android:singleLine="true" android:ellipsize="end"
        android:textColor="#DAE6EB" android:textSize="9sp"/>
    <TextView android:id="@+id/widget_row_values" android:layout_width="0dp"
        android:layout_weight="1.15" android:layout_height="wrap_content"
        android:layout_marginStart="4dp" android:gravity="end"
        android:singleLine="true" android:ellipsize="end"
        android:textColor="#59ED8A" android:textStyle="bold" android:textSize="9sp"/>
</LinearLayout>
